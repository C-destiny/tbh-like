{
  "name": "tbh-like",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, GM-driven idle RPG inspired by TBH: Task Bar Hero. Node + WebSocket + SQLite.",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node scripts/smoke.cjs && node scripts/ui-smoke.cjs",
    "test:engine": "node scripts/smoke.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:e2e": "node scripts/e2e.cjs",
    "balance": "node scripts/balance.cjs",
    "assets": "node scripts/prep-assets.cjs",
    "reset": "node scripts/reset.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  }
}
